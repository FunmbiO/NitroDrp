# Copy to .env (never commit it). Used by docker-compose.yml.
SENDER_NAME=Jaded Media
# Long random string. The upload page asks for it once and remembers it in the browser.
API_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=
DYNAMO_TABLE=nitrodrp
# Credentials of the IAM user created by infra/terraform (output: iam_user_name). Create the access key in the AWS console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# From `terraform output`. Leave CLOUDFRONT_DOMAIN empty to download straight from S3 instead.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Optional: lets "Delete link now" purge CloudFront's cache immediately.
CLOUDFRONT_DISTRIBUTION_ID=
# Optional: sign in with a passkey (Face ID, fingerprint, device PIN) instead of typing the access key on every
# device. Needs PUBLIC_BASE_URL below to be your https address. See docs/AUTH.md.
# PASSKEYS_ENABLED=true
# Optional: email download links (Amazon SES). Needs the SES setup in docs/EMAIL.md first.
# EMAIL_ENABLED=true
# EMAIL_FROM_ADDRESS=transfers@example.com
# Public address of this site. Passkeys are tied to it, and links in emails are built from it.
# PUBLIC_BASE_URL=https://drop.example.com
# SES region (defaults to AWS_REGION). Must be where the sending domain was verified.
# EMAIL_REGION=us-east-2
# Optional: notifications. The list inside the app is always on. These add a message on your phone (push) and a
# daily email. Make the keys with ./deploy/make-vapid.sh. See docs/NOTIFICATIONS.md.
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# Who the phone makers' push services can contact about this server: mailto:you@example.com or your https address.
# PUSH_SUBJECT=mailto:you@example.com
# Where the daily summary goes (needs email set up). Sent once a day, only if something happened.
# DIGEST_EMAIL_TO=you@example.com
# The hour (UTC, 0-23) the daily summary goes out.
# DIGEST_HOUR_UTC=13
# Sites allowed to embed this app in an iframe (CSP frame-ancestors). Default: none.
# FRAME_ANCESTORS="'self' https://portfolio.example.com"
# Public hostname for the Caddy profile (docs/LIGHTSAIL.md): its DNS must already point at this server.
# Remove the leading # when you set it: a commented-out line leaves it empty and Caddy won't start.
# SITE_ADDRESS=drop.example.com
# Cloudflare Zero Trust > Networks > Tunnels. Public hostname -> http://web:80
TUNNEL_TOKEN=
