# Copy to .env (never commit it). Used by docker-compose.yml.
SENDER_NAME=Jaded Media
# Long random string. The upload page asks for it once and remembers it in the browser.
API_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=
DYNAMO_TABLE=nitrodrp
# Credentials of the IAM user created by infra/terraform (output: iam_user_name). Create the access key in the AWS console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# From `terraform output`. Leave CLOUDFRONT_DOMAIN empty to download straight from S3 instead.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Cloudflare Zero Trust > Networks > Tunnels. Public hostname -> http://web:80
TUNNEL_TOKEN=
