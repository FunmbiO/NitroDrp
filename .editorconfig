# https://editorconfig.org: the same basics in every editor. `dotnet format` honours this too.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,sln,props}]
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown, so don't trim them
trim_trailing_whitespace = false

[*.sln]
indent_style = tab
