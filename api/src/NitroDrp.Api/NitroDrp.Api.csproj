<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NitroDrp.Api</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="AWSSDK.CloudFront" Version="3.7.510.21" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.513.4" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="3.7.509.10" />
  </ItemGroup>

</Project>
